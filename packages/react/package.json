{
  "name": "@dammers/anchor-presence-react",
  "version": "1.0.0",
  "description": "React hooks, provider, and optional configurable cursor components for anchor-presence",
  "license": "MIT",
  "author": "DammersCode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/anchor-presence.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/DammersCode/anchor-presence#readme",
  "keywords": [
    "live-cursors",
    "presence",
    "collaboration",
    "multiplayer",
    "cursor",
    "realtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build"
  },
  "dependencies": {
    "@dammers/anchor-presence-core": "1.0.0",
    "@dammers/anchor-presence-dom": "1.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "valibot": "^1.5.0"
  }
}
