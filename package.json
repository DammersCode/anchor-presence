{
  "name": "anchor-presence",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '@anchor-presence/*' build",
    "typecheck": "tsc --build packages/core packages/dom packages/react",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
