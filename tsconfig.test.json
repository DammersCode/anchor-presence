{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@anchor-presence/core": ["./packages/core/src/index.ts"],
      "@anchor-presence/dom": ["./packages/dom/src/index.ts"],
      "@anchor-presence/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": [
    "packages/*/test",
    "packages/core/bench",
    "apps/demo/src/cursors",
    "scripts/bench.ts",
    "scripts/relay-load.ts"
  ]
}
