{
  "name": "@dammers/anchor-presence-core",
  "version": "1.0.0",
  "description": "Framework-agnostic live cursor presence engine",
  "license": "MIT",
  "author": "DammersCode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DammersCode/anchor-presence.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DammersCode/anchor-presence#readme",
  "keywords": [
    "live-cursors",
    "presence",
    "collaboration",
    "multiplayer",
    "cursor",
    "realtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "import": "./dist/standard-schema.js",
      "default": "./dist/standard-schema.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build"
  },
  "devDependencies": {
    "valibot": "^1.5.0",
    "zod": "4.6.6",
    "arktype": "^2.2.10"
  }
}
