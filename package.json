{
  "name": "anchor-presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter '@dammers/anchor-presence-core' --filter '@dammers/anchor-presence-dom' --filter '@dammers/anchor-presence-react' build",
    "typecheck": "tsc --build packages/core packages/dom packages/react && tsc -p tsconfig.test.json && tsc -p apps/demo && bun run --cwd apps/docs typecheck && bun run typecheck:examples",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:react-compiler": "vitest run --config apps/demo/vitest.compiler.config.ts",
    "test:react-18": "vitest run --config test/react18.vitest.config.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run build && bun run --cwd apps/docs build",
    "bench": "bun run scripts/bench.ts",
    "preversion": "bun run build && bun run typecheck && bun run lint && bun run test",
    "version": "node scripts/sync-versions.mjs && bun install && git add package.json packages/*/package.json apps/*/package.json examples/*/package.json bun.lock",
    "postversion": "git push && git push --tags",
    "release:check": "node scripts/check-release.mjs",
    "typecheck:examples": "tsc -p examples/socketio && tsc -p examples/signalr && tsc -p examples/bun-native && tsc -p examples/node-ws && tsc -p examples/hono && tsc -p examples/elysia",
    "perf:score": "bun run scripts/perf-score.ts",
    "check:unused": "knip --no-progress --workspace packages/core --workspace packages/dom --workspace packages/react",
    "check:package": "node scripts/check-package.mjs",
    "test:bun-runtime": "bun scripts/runtime-smoke.ts",
    "audit": "bun audit --audit-level=high"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-router": "^1.170.46",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "knip": "^6.45.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.25",
    "react-router": "^8.5.1",
    "tinybench": "^6.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "^0.18.2"
  },
  "engines": {
    "node": ">=22"
  }
}
